{
  "$schema": "../claude-code-settings-schema.json",
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true,
    "security-guard@sdd-local": false
  },
  "sandbox": {
    "allowAppleEvents": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "credentials": {
      "envVars": [
        { "mode": "deny", "name": "GITHUB_TOKEN" },
        { "mode": "deny", "name": "GITHUB_AUTH_TOKEN" },
        { "mode": "deny", "name": "GITHUB_PERSONAL_ACCESS_TOKEN" },
        { "mode": "deny", "name": "GITHUB_PUBLICK_EMAIL" },
        { "mode": "deny", "name": "HUGGINGFACE_TOKEN" },
        { "mode": "deny", "name": "ANTHROPIC_API_KEY" },
        { "mode": "deny", "name": "GOOGLE_AI_API_KEY" },
        { "mode": "deny", "name": "GEMINI_API_KEY" },
        { "mode": "deny", "name": "OLLAMA_API_KEY" },
        { "mode": "deny", "name": "CONTEXT7_API_KEY" },
        { "mode": "deny", "name": "QWEN_CODER_API" },
        { "mode": "deny", "name": "INTELEPHENSE_LICENSE_KEY" },
        { "mode": "deny", "name": "Z_AI_API_KEY" },
        { "mode": "deny", "name": "ANTHROPIC_AUTH_TOKEN" },
        { "mode": "deny", "name": "ANTHROPIC_BASE_URL" },
        { "mode": "deny", "name": "NPM_CONFIG_TOKEN" },
        { "mode": "deny", "name": "NPM_CONFIG_TOKEN_TEST" }
      ],
      "files": [
        { "mode": "deny", "path": "~/.ssh" },
        { "mode": "deny", "path": "~/.aws" },
        { "mode": "deny", "path": "~/.gnupg" },
        { "mode": "deny", "path": "~/.gcloud" },
        { "mode": "deny", "path": "~/.config" },
        { "mode": "deny", "path": "~/.docker" },
        { "mode": "deny", "path": "~/.kube" },
        { "mode": "deny", "path": "~/.netrc" },
        { "mode": "deny", "path": "~/.npmrc" },
        { "mode": "deny", "path": "~/.pypirc" },
        { "mode": "deny", "path": "~/.htpasswd" },
        { "mode": "deny", "path": "~/.zshenv" },
        { "mode": "deny", "path": "~/.zprofile" },
        { "mode": "deny", "path": "~/.zprofile.local" },
        { "mode": "deny", "path": "~/.zshrc" },
        { "mode": "deny", "path": "~/.profile" },
        { "mode": "deny", "path": "~/.bash_profile" },
        { "mode": "deny", "path": "~/.bashrc" }
      ]
    },
    "enabled": true,
    "enabledPlatforms": ["macos"],
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": ["sudo", "grep", "find"],
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.gcloud",
        "~/.config",
        "~/.docker",
        "~/.kube",
        "**/.ssh",
        "**/.aws",
        "**/.gnupg",
        "**/.gcloud",
        "**/.docker",
        "**/.kube",
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.secret",
        "**/*.secrets",
        "**/id_rsa",
        "**/id_ed25519",
        "**/id_ecdsa",
        "**/.netrc",
        "**/.npmrc",
        "**/.pypirc",
        "**/.htpasswd",
        "**/credentials.json",
        "**/token.json",
        "**/terraform.tfstate",
        "~/.claude.json",
        "~/.claude/settings.json",
        "**/.claude/settings.json",
        "**/.claude/settings.local.json",
        "**/.git/hooks",
        "~/Library",
        "~/.zshenv",
        "~/.zprofile",
        "~/.zprofile.local",
        "~/.zshrc",
        "~/.profile",
        "~/.bash_profile",
        "~/.bashrc"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.gcloud",
        "~/.config",
        "~/.docker",
        "~/.kube",
        "**/.ssh",
        "**/.aws",
        "**/.gnupg",
        "**/.gcloud",
        "**/.docker",
        "**/.kube",
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/*.p12",
        "**/*.pfx",
        "**/*.secret",
        "**/*.secrets",
        "**/id_rsa",
        "**/id_ed25519",
        "**/id_ecdsa",
        "**/.netrc",
        "**/.npmrc",
        "**/.pypirc",
        "**/.htpasswd",
        "**/credentials.json",
        "**/token.json",
        "**/terraform.tfstate",
        "**/.git/hooks",
        "**/.git/config",
        "~/Library",
        "~/.vscode",
        "~/.cursor",
        "~/.zshenv",
        "~/.zshrc",
        "~/.zprofile",
        "~/.zprofile.local",
        "~/.profile",
        "~/.bashrc",
        "~/.bash_profile",
        "~/.vimrc",
        "~/.gitconfig",
        "~/Desktop",
        "~/Documents",
        "~/Downloads",
        "~/Movies",
        "~/Music",
        "~/Pictures",
        "~/Public",
        "~/Applications",
        "~/Sites"
      ]
    },
    "network": { "allowAllUnixSockets": true, "allowLocalBinding": true }
  }
}
