{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "plugins": [
      {
        "completions": true,
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "warning",
          "catchUnfailableEffect": "warning",
          "cryptoRandomUUID": "suggestion",
          "cryptoRandomUUIDInEffect": "suggestion",
          "extendsNativeError": "suggestion",
          "leakingRequirements": "warning",
          "outdatedApi": "error",
          "processEnv": "suggestion",
          "processEnvInEffect": "suggestion",
          "returnEffectInGen": "warning"
        },
        "diagnostics": true,
        "name": "@effect/language-service",
        "quickinfo": true
      }
    ],
    "preserveSymlinks": false,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "strictNullChecks": true
  },
  "exclude": ["node_modules", ".repos"],
  "extends": "@tsconfig/bun"
}
