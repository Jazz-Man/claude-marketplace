{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on",
        "useSortedSelectionSet": "on",
        "useSortedTypeFields": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!skills-lock.json",
      "!data-src",
      "!.grepai",
      "!packages/cli-hook/tests/fixtures",
      "!.jscpd-baseline.json"
    ]
  },
  "formatter": {
    "attributePosition": "multiline",
    "enabled": true,
    "expand": "auto",
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "trailingNewline": true
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "operatorLinebreak": "after",
      "quoteStyle": "double"
    },
    "globals": ["Bun"]
  },

  "linter": {
    "domains": {
      "project": "all",
      "test": "all",
      "types": "all"
    },
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveLinesPerFunction": "error",
        "noVoid": "error"
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUndeclaredVariables": {
          "level": "on",
          "options": {
            "checkTypes": true
          }
        },
        "noUnknownFunction": "error",
        "noUnusedVariables": "error",
        "useQwikValidLexicalScope": "off",
        "useSingleJsDocAsterisk": "error"
      },
      "performance": {
        "noAwaitInLoops": "error",
        "noBarrelFile": "error",
        "noNamespaceImport": "off",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "preset": "all",
      "security": {
        "noSecrets": "off"
      },
      "style": {
        "noExcessiveLinesPerFile": "error",
        "noMagicNumbers": "off",
        "noProcessEnv": "off",
        "noTernary": "off",
        "useBlockStatements": "error",
        "useExportsLast": "off",
        "useNamedCaptureGroup": "error",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noCommentText": "error",
        "noConsole": "off",
        "noTemplateCurlyInString": "off",
        "noUnnecessaryConditions": "error",
        "useExpect": "error"
      }
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "root": true,
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
