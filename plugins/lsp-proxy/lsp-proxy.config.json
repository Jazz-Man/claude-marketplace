{
  "servers": [
    {
      "args": ["--lsp", "--stdio"],
      "command": "tsc",
      "extensionToLanguage": {
        ".cjs": "javascript",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".ts": "typescript",
        ".tsx": "typescriptreact"
      },
      "initializationOptions": {},
      "name": "effect-tsgo",
      "settings": {}
    },
    {
      "args": [
        "client",
        "--server-path",
        "/opt/homebrew/bin/biome",
        "lsp-proxy"
      ],
      "command": "lspmux",
      "extensionToLanguage": {
        ".cjs": "javascript",
        ".css": "css",
        ".js": "javascript",
        ".json": "json",
        ".jsonc": "json",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".ts": "typescript",
        ".tsx": "typescriptreact"
      },
      "initializationOptions": {},
      "name": "biome",
      "settings": {}
    }
  ]
}
