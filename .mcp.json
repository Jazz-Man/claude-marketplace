{
  "mcpServers": {
    "grepai-api": {
      "args": ["mcp-serve"],
      "command": "grepai"
    },
    "jscpd-mcp": {
      "args": ["--mcp"],
      "command": "jscpd"
    },
    "lightpanda": {
      "args": ["mcp", "--obey-robots"],
      "command": "lightpanda",
      "env": {},
      "type": "stdio"
    }
  }
}
